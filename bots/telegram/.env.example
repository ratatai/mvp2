TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids of the RATATAI team (the bot tells anyone else their id)
ALLOWED_TELEGRAM_USER_IDS=

# Reading photos + understanding spoken/free-form searches
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
UNDERSTANDING_MODEL=claude-haiku-5-5

# Voice messages (speech to text)
OPENAI_API_KEY=
SPEECH_MODEL=gpt-4o-transcribe

# Stock database and photo backup (keep both on a persistent disk and back them up)
DATABASE_PATH=./data/ratatai-bot.sqlite
PHOTO_DIR=./data/photos

# Alternative: self-hosted open-source vision model
# VISION_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=qwen2.5vl:7b
# OPENAI_COMPATIBLE_API_KEY=
