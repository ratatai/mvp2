# ---------------------------------------------------------------------------
# RATATAI marketplace — environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# NEVER commit .env.local. NEVER put a service_role / secret key in this file:
# every NEXT_PUBLIC_* variable is shipped to the browser.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key (the public one, never the secret key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of the deployed marketplace, used for canonical URLs, Open Graph
# and sitemap generation. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
